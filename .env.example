# Telegram Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Kalshi v2 API (RSA-PSS Authenticated Orders & Live Balance)
KALSHI_API_KEY=your_kalshi_key_id_here
KALSHI_PRIVATE_KEY_PATH=/home/peezy_bot/kalshi_private.pem
# Or inline PEM with escaped newlines:
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Gemini AI API (Sharp +EV Prop Writeups)
GEMINI_API_KEY=your_gemini_api_key_here

# Simulation & Auto-Trading Settings (mirrors KalshiQuant bot.py)
DEFAULT_MODE=SIM
DEFAULT_AUTO=false
DEFAULT_SIM_CASH=1009.00
AUTO_SCAN_INTERVAL_SEC=30
SETTLE_POLL_INTERVAL_SEC=60
