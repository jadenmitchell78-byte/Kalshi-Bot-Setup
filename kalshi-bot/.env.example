# ─────────────────────────────────────────────────────────────────
# Bot Suite — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# All secrets are also stored as Replit Secrets (encrypted).
# ─────────────────────────────────────────────────────────────────

# ── Kalshi ────────────────────────────────────────────────────────
KALSHI_API_KEY=your-kalshi-api-key-here       # ✅ already stored as Replit Secret
KALSHI_API_SECRET=your-kalshi-private-key-pem # RSA private key for request signing
KALSHI_ENV=prod                               # "prod" or "demo"

# ── Telegram ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=                           # BotFather token (e.g. 123456:ABC-DEF...)
TELEGRAM_CHAT_ID=                             # Your personal chat/thread ID

# ── AI / LLM ──────────────────────────────────────────────────────
GEMINI_API_KEY=                               # Google Gemini (used by betting_parser, auto_runner)
OPENAI_API_KEY=                               # OpenAI GPT-4o-mini (used by betting_parser, betting_trends)

# ── Sports Odds ───────────────────────────────────────────────────
THE_ODDS_API_KEY=                             # The Odds API (betting_validation.py)

# ── Social / X (Twitter) ──────────────────────────────────────────
X_API_KEY=                                    # X Developer API key (social_trail_bot, sentiment_sniper)
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Polymarket ────────────────────────────────────────────────────
POLYMARKET_API_KEY=                           # poly_trader.py
POLYMARKET_PRIVATE_KEY=
POLYMARKET_API_PASSPHRASE=
METAMASK_PRIVATE_KEY=                         # EVM wallet private key
WALLET_ADDRESS=
PRIVATE_POLYGON_RPC=                          # Optional: private Polygon RPC to prevent front-running
POLY_PROXY=                                   # Optional: proxy URL to bypass Polymarket geoblock

# ── Solana ────────────────────────────────────────────────────────
# Wallet stored as solana_key.json (see watchdog.py)

# ── Optional Integrations ─────────────────────────────────────────
CLICKUP_API_TOKEN=                            # brain.py ClickUp reporting
CLICKUP_VIEW_ID=
DISCORD_WEBHOOK_URL=                          # discord webhook for trade alerts
