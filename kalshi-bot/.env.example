# ─────────────────────────────────────────────
# Kalshi Bot — Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────

# Kalshi API credentials
KALSHI_API_KEY=your-api-key-here
KALSHI_API_SECRET=your-api-secret-here

# Kalshi environment: "demo" or "prod"
KALSHI_ENV=demo

# Telegram bot (optional — for trade notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI (optional — for AI-assisted signals)
OPENAI_API_KEY=

# Polymarket (optional)
POLYMARKET_PRIVATE_KEY=
